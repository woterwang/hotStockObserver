{
  "name": "hot-stock-observer-server",
  "version": "1.0.0",
  "description": "每日热搜股票观察系统 - 后端服务",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc && node -e \"const fs=require('fs'); const path=require('path'); const src=path.join(process.cwd(),'src','utils','thsUtils.js'); const destDir=path.join(process.cwd(),'dist','utils'); const dest=path.join(destDir,'thsUtils.js'); fs.mkdirSync(destDir,{recursive:true}); fs.copyFileSync(src,dest); console.log('copied', dest);\"",
    "start": "node dist/app.js",
    "import-data": "tsx src/scripts/importHistoricalData.ts",
    "backfill": "tsx src/scripts/backfillBreakthrough.ts",
    "sync:volumeRatio": "tsx src/scripts/syncVolumeRatioToBuySignals.ts",
    "test:updateCache": "node test-update-cache.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.7.0",
    "mongoose": "^8.0.3",
    "node-cron": "^3.0.3",
    "p-limit": "^7.2.0",
    "simple-git": "^3.21.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "cors": "^2.8.6",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  }
}
