### 
# 服务器配置
PORT=80
NODE_ENV=development

# MongoDB配置
MONGODB_URI=mongodb://localhost:27017/hot_stock_observer

# 日志配置
LOG_LEVEL=info

# 定时任务配置（Cron表达式）
# 每个交易日9:30-15:00每5分钟更新一次
CRON_UPDATE_INTERVAL=*/5 9-15 * * 1-5

# 数据源配置
DATA_SOURCE_URL=https://eq.10jqka.com.cn/open/api/hot_list/v1/hot_stock/a/day/data.txt

# 请求配置
REQUEST_TIMEOUT=10000
REQUEST_RETRY_TIMES=3
