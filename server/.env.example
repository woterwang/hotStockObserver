### 
# 服务器配置
# HTTP 监听端口；PM2 注入 PORT 时以其为准
PORT=80
# 运行模式；production 模式同时托管构建后的前端，PM2 注入时以其为准
NODE_ENV=development

# MongoDB配置
MONGODB_URI=mongodb://localhost:27017/hot_stock_observer

# 日志配置
LOG_LEVEL=info

# 定时任务配置（Cron表达式）
# 每个交易日9:30-15:00每5分钟更新一次
CRON_UPDATE_INTERVAL=*/5 9-15 * * 1-5

# 数据源配置
DATA_SOURCE_URL=https://eq.10jqka.com.cn/open/api/hot_list/v1/hot_stock/a/day/data.txt

# 请求配置
REQUEST_TIMEOUT=10000
REQUEST_RETRY_TIMES=3

# 企业微信机器人通知
# 创建群机器人后，将 YOUR_KEY_HERE 替换为机器人的 key
WECHAT_WORK_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE
# 企业微信机器人请求超时（毫秒）
WECHAT_NOTIFY_TIMEOUT=10000

# Ticket 到期提醒：提前几天开始每天推送
THS_TICKET_REMINDER_DAYS=5
# 每天检查的 Cron 表达式（北京时间）
THS_TICKET_REMINDER_CRON=0 9 * * *
# Ticket 到期提醒专用机器人，不影响股票通知
WECHAT_TICKET_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE

# 管理接口密钥：在设置页验证管理员身份时输入，不要提交真实值
ADMIN_API_KEY=

# 同花顺自选分组凭据：设置页验证通过后会将以下四项重写到文件末尾
# THS_TICKET：同花顺 Cookie 中 ticket= 后的值
# THS_USER：同花顺 Cookie 中 user= 后的原始值；更新时留空则沿用旧值
# THS_TICKET_UPDATED_AT：凭据更新日期（YYYY-MM-DD）
# THS_TICKET_EXPIRES_AT：用于提醒的到期日期（YYYY-MM-DD），设置页按更新日加 90 天估算
THS_TICKET=
THS_USER=
THS_TICKET_UPDATED_AT=
THS_TICKET_EXPIRES_AT=2027-02-25
